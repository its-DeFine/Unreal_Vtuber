# Cloudflare TURN credentials for WebRTC media relay.
# Copy to .env.cloudflare-turn (or add these vars to .env) and fill in values.
# Generate at: dash.cloudflare.com → Realtime → TURN Server → Create
#
# When CF_TURN_TOKEN_ID and CF_TURN_API_TOKEN are set, the signaling server
# fetches short-lived TURN credentials from Cloudflare at container startup,
# replacing the local coturn relay.

CF_TURN_TOKEN_ID=
CF_TURN_API_TOKEN=

# Credential TTL in seconds (default: 86400 = 24h, refreshed on container restart)
CF_TURN_TTL=86400

# Force TURN-only (hides orchestrator IP from clients). Set to 0 to allow direct connections.
CF_TURN_RELAY_ONLY=1
