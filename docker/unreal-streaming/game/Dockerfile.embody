# Combined Embody UE game + Pixel Streaming signalling container
FROM ghcr.io/its-define/unreal_vtuber/embody-ue-ps:latest AS base

USER root

ARG PS_BRANCH=UE5.5

# Install build dependencies and Node.js 18
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gnupg \
    build-essential \
    python3 \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Fetch Pixel Streaming infrastructure sources
RUN git clone --depth 1 --branch "${PS_BRANCH}" https://github.com/EpicGames/PixelStreamingInfrastructure.git /opt/pixel-streaming

# Build shared Common library
WORKDIR /opt/pixel-streaming/Common
RUN npm ci \
    && npm run build \
    && npm cache clean --force

# Build signalling core library
WORKDIR /opt/pixel-streaming/Signalling
RUN npm ci \
    && npm link ../Common \
    && npm run build \
    && npm cache clean --force

# Build frontend libraries and UI so player.html is available
WORKDIR /opt/pixel-streaming/Frontend/library
RUN npm ci \
    && npm link ../../Common \
    && npm run build \
    && npm link \
    && npm cache clean --force

WORKDIR /opt/pixel-streaming/Frontend/ui-library
RUN npm ci \
    && npm link ../library \
    && npm run build \
    && npm link \
    && npm cache clean --force

WORKDIR /opt/pixel-streaming/Frontend/implementations/typescript
RUN npm ci \
    && npm link @epicgames-ps/lib-pixelstreamingfrontend-ue5.5 \
    && npm link @epicgames-ps/lib-pixelstreamingfrontend-ui-ue5.5 \
    && npm run build \
    && npm cache clean --force

# Build the signalling web server bundle
WORKDIR /opt/pixel-streaming/SignallingWebServer
RUN npm ci \
    && npm link ../Signalling \
    && npm run build \
    && npm cache clean --force

# Copy entrypoint wrapper
COPY docker/unreal-streaming/game/start-embody-stack.sh /usr/local/bin/start-embody-stack.sh
RUN chmod +x /usr/local/bin/start-embody-stack.sh

# Ensure runtime user can access the signalling tree
RUN chown -R embody:embody /opt/pixel-streaming

USER embody
WORKDIR /opt/embody

ENV SIGNALING_HTTP_PORT=8080 \
    SIGNALING_STREAMER_PORT=8888 \
    SIGNALING_SFU_PORT=8889 \
    AUTO_PUBLIC_IP=1

EXPOSE 7777 8080 8888 8889

ENTRYPOINT ["/usr/local/bin/start-embody-stack.sh"]
