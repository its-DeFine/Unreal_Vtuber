# Autonomous Orchestrator Quick Fix Settings
# These values override the defaults to create more natural speech patterns

# Idle timeout before considering autonomous content (seconds)
ORCHESTRATOR_IDLE_TIMEOUT=15.0

# How often to check for decisions (seconds)
DECISION_LOOP_INTERVAL=1.0

# Minimum gap between speeches (enforced in code)
# MIN_SPEECH_GAP=5.0

# Optional: Disable autonomous content entirely
# AUTONOMOUS_ORCHESTRATION_ENABLED=false
