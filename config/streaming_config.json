{
  "destinations": [
    {
      "name": "twitch_main",
      "url": "rtmp://live.twitch.tv/app/${TWITCH_STREAM_KEY}",
      "protocol": "rtmp",
      "stream_type": "hybrid",
      "enabled": true,
      "priority": 10,
      "metadata": {
        "platform": "twitch",
        "quality": "1080p60",
        "low_latency": true
      }
    },
    {
      "name": "youtube_live",
      "url": "rtmp://a.rtmp.youtube.com/live2/${YOUTUBE_STREAM_KEY}",
      "protocol": "rtmp",
      "stream_type": "hybrid", 
      "enabled": false,
      "priority": 8,
      "metadata": {
        "platform": "youtube",
        "quality": "1080p",
        "backup": true
      }
    },
    {
      "name": "local_rtmp",
      "url": "rtmp://nginx_rtmp:1935/live/mystream",
      "protocol": "rtmp",
      "stream_type": "audio_rtmp",
      "enabled": true,
      "priority": 5,
      "metadata": {
        "platform": "local",
        "testing": true
      }
    },
    {
      "name": "unreal_video_out",
      "url": "rtmp://nginx_rtmp:1935/live/unreal",
      "protocol": "rtmp",
      "stream_type": "video_unreal",
      "enabled": true,
      "priority": 7,
      "metadata": {
        "source": "unreal_engine",
        "capture_method": "pixel_streaming"
      }
    }
  ],
  "sources": [
    {
      "name": "neurosync_audio",
      "source_type": "file",
      "location": "/tmp/audio_output",
      "format": "wav",
      "metadata": {
        "component": "neurosync",
        "sample_rate": 44100,
        "channels": 2
      }
    },
    {
      "name": "unreal_viewport",
      "source_type": "capture",
      "location": "main_viewport",
      "format": "raw",
      "metadata": {
        "component": "unreal_engine",
        "resolution": "1920x1080",
        "framerate": 30
      }
    },
    {
      "name": "combined_av",
      "source_type": "pipeline",
      "location": "neurosync_audio+unreal_viewport",
      "format": "mixed",
      "metadata": {
        "sync_method": "pts",
        "audio_delay_ms": 0
      }
    }
  ],
  "data_sources": [
    {
      "name": "chat_aggregator",
      "source_type": "websocket",
      "endpoint": "ws://localhost:8080/chat",
      "polling_interval": 0,
      "filters": {
        "platforms": ["twitch", "youtube"],
        "message_types": ["chat", "superchat", "subscription"]
      },
      "transformers": ["filter_keywords", "extract_sentiment"],
      "metadata": {
        "purpose": "audience_interaction"
      }
    },
    {
      "name": "analytics_api",
      "source_type": "rest_api",
      "endpoint": "https://api.streamlabs.com/analytics",
      "auth": {
        "api_key": "${STREAMLABS_API_KEY}"
      },
      "polling_interval": 30,
      "filters": {
        "metrics": ["viewers", "followers", "donations"]
      },
      "transformers": ["normalize_numbers"],
      "metadata": {
        "purpose": "performance_tracking"
      }
    },
    {
      "name": "social_media_feed",
      "source_type": "rest_api",
      "endpoint": "https://api.twitter.com/2/tweets/search/stream",
      "auth": {
        "bearer_token": "${TWITTER_BEARER_TOKEN}"
      },
      "polling_interval": 10,
      "filters": {
        "keywords": ["#vtuber", "@channel_name"],
        "languages": ["en", "ja"]
      },
      "transformers": ["extract_sentiment", "summarize"],
      "metadata": {
        "purpose": "social_monitoring"
      }
    },
    {
      "name": "game_state",
      "source_type": "websocket",
      "endpoint": "ws://localhost:9999/game",
      "polling_interval": 0,
      "filters": {},
      "transformers": [],
      "metadata": {
        "purpose": "game_integration",
        "game": "unreal_engine"
      }
    }
  ],
  "agent_configurations": [
    {
      "agent_id": "main_streamer",
      "default_stream_source": "combined_av",
      "default_data_sources": ["chat_aggregator", "analytics_api"],
      "selection_strategy": "priority",
      "auto_switch_on_failure": true
    },
    {
      "agent_id": "backup_streamer",
      "default_stream_source": "neurosync_audio",
      "default_data_sources": ["chat_aggregator"],
      "selection_strategy": "quality",
      "auto_switch_on_failure": false
    }
  ],
  "global_settings": {
    "max_concurrent_streams": 3,
    "buffer_size_mb": 10,
    "reconnect_attempts": 3,
    "reconnect_delay_seconds": 5,
    "low_latency_mode": true,
    "enable_monitoring": true,
    "monitoring_interval_seconds": 10
  }
}