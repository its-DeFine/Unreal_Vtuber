# Livepeer orchestrator configuration (example)
# Copy this file to config/vtuber.conf, fill in secrets, and launch via docker-compose.
network arbitrum-one-mainnet
ethUrl https://arb1.arbitrum.io/rpc
orchestrator true
transcoder true
aiWorker true
serviceAddr your.public.hostname:9995
cliAddr 0.0.0.0:7935
v 6
orchSecret orch-secret
blockPollingInterval 20
pricePerUnit 16000000000000
ticketEV 16000000000000
maxGasPrice 1000000000
autoAdjustPrice false
reward false
ethPassword /root/.lpData/.ethpass
ethAcctAddr 0xYOUR_ETH_ACCOUNT_ADDRESS
ethOrchAddr 0xYOUR_ORCHESTRATOR_ADDRESS
datadir /root/.lpData/
monitor true
aiVerboseLogs true
testTranscoder false
startupAvailabilityCheck false
