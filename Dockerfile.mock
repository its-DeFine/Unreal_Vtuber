FROM vtuber-orchestrator:v1

# Add version indicator
ENV ORCHESTRATOR_VERSION="v2-mock-update"
ENV UPDATE_TEST="SUCCESS"

# Add a marker file to show update worked
RUN echo "Version 2 - Updated at $(date)" > /app/version.txt

# Log the version on startup
RUN echo 'echo "=== ORCHESTRATOR VERSION: ${ORCHESTRATOR_VERSION} ===" && cat /app/version.txt 2>/dev/null || true' > /app/show_version.sh && \
    chmod +x /app/show_version.sh

# Modify entrypoint to show version
ENTRYPOINT ["/bin/sh", "-c", "/app/show_version.sh && python -m src.main"]