# Copy this to autonomy/.env

# ======================================
# 🎛️ CENTRAL MANAGER INTEGRATION
# ======================================
CENTRAL_MANAGER_URL=https://central-manager.quantumyield.co
CENTRAL_MANAGER_TOKEN=test-api-key-2024
AGENT_REGISTRATION_ENABLED=true
ORCHESTRATOR_NAME=local_vtuber_orchestrator
# IMPORTANT: Remote orchestrators MUST set ORCHESTRATOR_URL in .env to their public URL
ORCHESTRATOR_URL=http://host.docker.internal:8082

# ======================================
# 🎬 LIVEPEER BYOC CONFIGURATION
# ======================================
# Manager Connection (REQUIRED for orchestrator registration)
MANAGER_URL=http://86.106.138.188:8010/api # Leave this as is, it's required for callbacks
MANAGER_API_KEY=test-api-key-2024
CENTRAL_MANAGER_TOKEN=test-api-key-2024  # Added for compatibility

# Orchestrator Identity
ORCHESTRATOR_ID=example-orchestrator-001
ORCHESTRATOR_SECRET=example-super-secret-key-32-chars-minimum
ORCHESTRATOR_NAME=example-vtuber-autonomy

# Livepeer Orchestrator Settings
LIVEPEER_IMAGE_TAG=sha-5627b90
LIVEPEER_NETWORK=arbitrum-one-mainnet
ORCHESTRATOR_PORT=9995
ORCHESTRATOR_HOST=0.0.0.0
LIVEPEER_ORCH_URL=https://livepeer-orchestrator:${ORCHESTRATOR_PORT}
LIVEPEER_ORCH_SECRET=orch-secret

# Ethereum Configuration
ETH_RPC_URL=https://arb1.arbitrum.io/rpc
ETH_PASSWORD_FILE=/root/.lpData/.ethpass  # File inside container; populate config/ethpass with the password
ETH_ADDRESS=0x0000000000000000000000000000000000000000  # Example ETH address
ETH_ORCH_ADDRESS=0x0000000000000000000000000000000000000000  # Typically same as ETH_ADDRESS

# Orchestrator Pricing / Ticketing
PRICE_PER_UNIT=0
TICKET_EV=0
AUTO_ADJUST_PRICE=false
MAX_GAS_PRICE=1000000000
# MAX_FACE_VALUE can be set if required; omitted by default

# Worker pricing
CAPABILITY_PRICE_PER_UNIT=0

# Worker Capability Settings
# Note: You need to set up a unique capability name for your orhcestrator
CAPABILITY_NAME=agent-net  # Livepeer capability name (e.g., agent-net, compute, transcoding)
CAPABILITY_DESCRIPTION=Run autonomous Embodied agents
CAPABILITY_PRICE_SCALING=1
CAPABILITY_CAPACITY=10
MIN_SERVICE_UPTIME=80.0

# Network Settings
WORKER_PORT=9876
PUBLIC_IP=auto
VTUBER_TCP_HOST=host.docker.internal
VTUBER_TCP_PORT=7777
VTUBER_SESSION_DIR=/home/ubuntu/vtuber_sessions
VTUBER_ALLOWED_ADDRESSES=
STUN_SERVER=stun.l.google.com:19302
ENABLE_REST_API=0
SIGNALING_EXTRA_ARGS=
NVIDIA_DRIVER_CAPABILITIES=all
NVIDIA_VISIBLE_DEVICES=all

# Performance Tuning
CONCURRENT_JOBS=5
BUFFER_SIZE_MB=10
LOW_LATENCY_MODE=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
REPORT_INTERVAL=60

# Auto-Updates
AUTO_UPDATE=false
UPDATE_CHECK_INTERVAL=3600

# ======================================
# 🔑 CORE API KEYS & SECRETS
# ======================================
# OpenAI Configuration(Not needed)
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Configuration(Not needed)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs TTS(Not needed)
ELEVENLABS_API_KEY=your-elevenlabs-key-here


# ======================================
# 🤖 LLM PROVIDER CONFIGURATION
# ======================================
LLM_PROVIDER=ollama
OLLAMA_API_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
USE_OLLAMA_TEXT_MODELS=true
OLLAMA_SMALL_MODEL=llama3.2:3b
OLLAMA_MEDIUM_MODEL=phi3:mini
OLLAMA_LARGE_MODEL=llama3.2:7b

# ======================================
# 🗄️ DATABASE CONFIGURATION
# ======================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/autonomous_agent

# ======================================
# 🔄 REDIS & SCB CONFIGURATION
# ======================================
USE_REDIS_SCB=true
REDIS_SCB_URL=redis://redis_scb:6379/0
SCB_API_DEBUG=true
SCB_POLL_INTERVAL_MS=15000

# ======================================
# 🎤 AUDIO & TTS CONFIGURATION
# ======================================
TTS_PROVIDER=kokoro
KOKORO_TTS_SERVER_URL=http://kokoro_tts:8880
KOKORO_DEFAULT_VOICE=af_sarah
KOKORO_TTS_TIMEOUT=30
KOKORO_TTS_LANGUAGE=en

# ======================================
# 🎮 VTUBER SYSTEM CONFIGURATION
# ======================================
VTUBER_ENDPOINT_URL=http://neurosync:5001/process_text
VTUBER_PAYMENT_ENABLED=false
AUTONOMOUS_LOOP_INTERVAL=30000

# ======================================
# 🧠 MEMORY CONFIGURATION
# ======================================
MEMORY_ARCHIVING_ENABLED=true
MEMORY_ACTIVE_LIMIT=200
MEMORY_ARCHIVE_HOURS=48
MEMORY_IMPORTANCE_THRESHOLD=0.3

# ======================================
# 🌐 NETWORK & PORTS
# ======================================
PORT=3000
PLAYER_PORT=5001
UI_PORT=3000

# ======================================
# 📊 LOGGING & MONITORING
# ======================================
LOG_LEVEL=INFO
DB_LOGGING=false
NODE_ENV=development
DEBUG=false
