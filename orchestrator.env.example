# ---------------------------------
# Payments + orchestration settings
# ---------------------------------
PAYMENTS_API_URL=http://3.141.111.200:8081
# Choose a unique orchestrator ID (1-64 chars; letters/numbers/dot/underscore/dash).
ORCHESTRATOR_ID=
# Your payout wallet (0x + 40 hex chars).
ORCHESTRATOR_ADDRESS=
ORCHESTRATOR_REGISTRATION_DELAY=10
ORCHESTRATOR_HEALTH_URL=http://<PUBLIC_IP>:9090/health
MONITORED_SERVICES=vtuber-unreal-game,vtuber-unreal-signaling,vtuber-turn-server
# Allowlist for runner/recorder/power endpoints (comma-separated). Set this to your Embody edge/gateway IP(s).
VTUBER_ALLOWED_ADDRESSES=127.0.0.1,::1
# Optional: bearer-token auth for runner/recorder-control (in addition to IP allowlisting).
# If unset/empty, the endpoints rely on IP allowlists only.
RUNNER_API_TOKEN=
RECORDINGS_API_TOKEN=
# change to a writable path on your host
VTUBER_SESSION_DIR=/home/ubuntu/vtuber_sessions
# host path mounted to /recordings inside recorder-control
VTUBER_RECORDINGS_DIR=/home/ubuntu/recordings
# Recorder tuning (optional): wait for streamers + allow video-only capture when audio is missing.
RECORDER_STREAMER_WAIT_SECONDS=30
RECORDER_STREAMER_POLL_SECONDS=2
RECORDER_AV_WAIT_SECONDS=3
# pin service images (runner/recorder/health/watchdog/registration)
EMBODY_SERVICE_IMAGE_TAG=latest

# ---------------------------------
# Networking
# ---------------------------------
PUBLIC_IP=auto
# GPU selection (optional): "all" or comma-separated indexes (e.g., 0 or 0,1)
# NVIDIA_VISIBLE_DEVICES=all
SIGNALING_EXTRA_ARGS=
# Optional: appended automatically by compose; can be managed by orchestrator-edge-rotator.
SIGNALING_MATCHMAKER_ARGS=
ENABLE_REST_API=0

# ---------------------------------
# Optional: NanoClaw agent-negotiator plugin runtime env
# ---------------------------------
# Customer-facing MCP endpoint bind + port (used by NanoClaw plugin boot)
NEGOTIATOR_HOST=0.0.0.0
NEGOTIATOR_PORT=9100
# 0 = accepting bookings, 1 = reject new bookings
NEGOTIATOR_KILLSWITCH=0
# requests per minute per IP
NEGOTIATOR_RATE_LIMIT=30
# Optional bearer auth token for MCP endpoints (/health stays open)
# NEGOTIATOR_API_TOKEN=
# Optional routable base URL returned as signaling_url to customers (e.g. https://<PUBLIC_DNS>)
# NEGOTIATOR_SIGNALING_PUBLIC_BASE_URL=
# Optional internal base URL for readiness polls after /cluster/deploy (defaults to ORCHESTRATOR_HEALTH_URL host)
# NEGOTIATOR_SIGNALING_CHECK_BASE_URL=
# Optional path to machine-readable entitlement/payment policy block in SKILL.md
# NEGOTIATOR_SKILL_POLICY_FILE=/config/client-embodied-control.SKILL.md
# Optional HMAC secret for zero-price signed-message rail (unless overridden by policy secret_env)
# NEGOTIATOR_SIGNED_MESSAGE_SECRET=

# ---------------------------------
# Optional: orchestrator-edge-rotator (edge routing + firewall allowlist)
# ---------------------------------
# EDGE_CONFIG_URL=https://<control-plane>/orchestrator-edge
# EDGE_CONFIG_TOKEN=
# EDGE_UPDATE_TURN=1
# EDGE_FIREWALL_EXTRA_CIDRS=<payments-ip>/32
# EDGE_POWER_EXTRA_CIDRS=<payments-ip>/32
# (Optional hardening) lock :9090 to Payments-only CIDRs, even while other ports remain edge-allowlisted.
# EDGE_OPS_PORTS=9090/tcp
# EDGE_OPS_ALLOW_CIDRS=<payments-ip>/32
# EDGE_LOCAL_ALLOWLIST=127.0.0.1,::1,172.17.0.1,172.18.0.1
# EDGE_ALLOW_PORTS=8080/tcp,8888/tcp,8889/tcp,9090/tcp,9100/tcp,9877/tcp,3478/tcp,3478/udp,49160-49200/udp
# Keep the rotator up during /power sleep.
# POWER_KEEP_RUNNING_SERVICES=orchestrator-edge-rotator
#
# Experimental: allow remote cluster instance deploy/down via :9090/cluster/*
# (Requires POWER_ALLOWED_IPS / VTUBER_ALLOWED_ADDRESSES allowlisting.)
EXPERIMENTAL_REMOTE_CLUSTER_CONTROL=1
# ORCHESTRATOR_PROJECT_DIR=/home/ubuntu/Unreal_Vtuber
# CLUSTER_EXECUTOR_CONTAINER=vtuber-orchestrator-edge-rotator
#
# Experimental: allow remote ops endpoints (upgrade/rollout) via :9090/ops/*
# (Requires POWER_ALLOWED_IPS / VTUBER_ALLOWED_ADDRESSES allowlisting.)
EXPERIMENTAL_REMOTE_OPS=1
#
# Optional hardening for /ops/* + /cluster/*:
# - If OPS_HMAC_SECRET is set, clients may send X-Embody-Ops-Timestamp + X-Embody-Ops-Signature.
# - If OPS_HMAC_REQUIRED=1, unsigned requests are rejected.
# OPS_HMAC_SECRET=
# OPS_HMAC_REQUIRED=0
# OPS_HMAC_TTL_SECONDS=300
#
# For remote rollout, the executor container needs read access to the orchestrator license token file.
# Default token path created by `./scripts/embody_cli.sh license redeem` on Ubuntu:
#   /home/ubuntu/.embody/orch-license-token.txt
# ORCH_LICENSE_TOKEN_FILE=/home/ubuntu/.embody/orch-license-token.txt

# ---------------------------------
# Optional metadata (sent to payments backend)
# ---------------------------------
# ORCHESTRATOR_CONTACT_EMAIL=ops@example.com
# ORCHESTRATOR_CAPABILITY=vtuber

# ---------------------------------
# Storage unit (optional)
# ---------------------------------
