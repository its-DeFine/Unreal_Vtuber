# ---------------------------------
# Payments + orchestration settings
# ---------------------------------
PAYMENTS_API_URL=http://3.141.111.200:8081
ORCHESTRATOR_ID=orch-local-001
ORCHESTRATOR_ADDRESS=0x0000000000000000000000000000000000000000
ORCHESTRATOR_REGISTRATION_DELAY=10
ORCHESTRATOR_HEALTH_URL=http://<PUBLIC_IP>:9090/health
MONITORED_SERVICES=vtuber-unreal-game,vtuber-unreal-signaling,vtuber-turn-server
# Allowlist for runner/recorder/power endpoints (comma-separated). Set this to the forwarder IP so it can push plans/recordings.
VTUBER_ALLOWED_ADDRESSES=127.0.0.1,::1,3.150.172.153
VTUBER_SESSION_DIR=/home/ubuntu/vtuber_sessions    # change to a writable path on your host
VTUBER_RECORDINGS_DIR=/home/ubuntu/recordings      # host path mounted to /recordings inside recorder-control
EMBODY_SERVICE_IMAGE_TAG=latest                  # pin service images (runner/recorder/health/watchdog/registration)

# ---------------------------------
# Networking
# ---------------------------------
PUBLIC_IP=auto
SIGNALING_EXTRA_ARGS=
ENABLE_REST_API=0

# ---------------------------------
# Optional metadata (sent to payments backend)
# ---------------------------------
# ORCHESTRATOR_CONTACT_EMAIL=ops@example.com
# ORCHESTRATOR_CAPABILITY=vtuber

# ---------------------------------
# Storage unit (optional)
# ---------------------------------
