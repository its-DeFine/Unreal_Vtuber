FROM python:3.10-slim

# --------------------------------------------------------
#  Base image for NeuroSync Local-API + Player
# --------------------------------------------------------

# Prevents Python from writing pyc files & enables unbuffered logs
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/usr/lib/python3/dist-packages:/usr/local/lib/python3.10/site-packages"

# System deps – lightweight subset (audio + basic build chain)
RUN apt-get update --fix-missing && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        git gcc g++ build-essential \
        libasound2 libsndfile1 portaudio19-dev libportaudio2 \
        ffmpeg \
        gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
        python3-gi python3-gst-1.0 gir1.2-gstreamer-1.0 \
        libgirepository1.0-dev pkg-config libcairo2-dev python3-cairo-dev \
        libglib2.0-dev libffi-dev \
        && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy NeuroBridge source once – contains both Local-API and Player
COPY ./NeuroBridge /app/NeuroBridge

# Install Python dependencies
#   • requirements.txt (Player) already includes numpy, torch, etc.
#   • Add Flask / Flask-CORS explicitly for Local-API
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir flask flask-cors pygame PyAudio librosa pycairo && \
    pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r /app/NeuroBridge/NeuroSync_Player/requirements.txt

# Convenience: show final installed packages (useful in build logs)
RUN pip list --format=columns | head -n 40

# Default command – will be overridden per-service by docker-compose
CMD ["python", "-m", "pip", "--version"]

# Expose both potential service ports
EXPOSE 5000 5001 