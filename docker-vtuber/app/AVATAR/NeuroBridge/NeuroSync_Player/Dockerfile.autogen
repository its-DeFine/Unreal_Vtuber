# Dockerfile for AutoGen Orchestrator V3
FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.autogen.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.autogen.txt

# Copy application code
COPY autogen_orchestrator_v3.py .
COPY autogen_agents.py .
COPY autogen_state_manager.py .
COPY autogen_content_strategies.py .
COPY orchestrator_integration_v3.py .
COPY autogen_api_routes.py .
COPY autonomous_orchestrator_v2.py .
COPY autonomous_orchestrator_wrapper.py .

# Copy any additional modules
COPY utils/ ./utils/

# Create necessary directories
RUN mkdir -p logs data

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV AUTOGEN_ORCHESTRATOR_ENABLED=true

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/orchestrator/v3/health').raise_for_status()"

# Run the orchestrator service
CMD ["python", "-m", "uvicorn", "autogen_orchestrator_service:app", "--host", "0.0.0.0", "--port", "8000"]