# GraphFlow External Stimuli System - Development Configuration Example

# Core Settings
GRAPHFLOW_LOG_LEVEL=INFO
GRAPHFLOW_MAX_CONCURRENT_STIMULI=50
GRAPHFLOW_PROCESSING_TIMEOUT=30.0
GRAPHFLOW_IDLE_THRESHOLD_SECONDS=300

# LLM Configuration
GRAPHFLOW_LLM_PROVIDER=ollama
GRAPHFLOW_LLM_MODEL=llama3.2:3b
GRAPHFLOW_LLM_ENDPOINT=http://localhost:11434
GRAPHFLOW_LLM_API_KEY=
GRAPHFLOW_LLM_TEMPERATURE=0.7
GRAPHFLOW_LLM_MAX_TOKENS=500

# Integration Endpoints
SYSTEM1_VTUBER_ENDPOINT=http://localhost:5001
SYSTEM1_API_KEY=
SYSTEM2_AUTOGEN_ENDPOINT=http://localhost:3100
SYSTEM2_API_KEY=

# Database Connections
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
POSTGRES_URL=postgresql://postgres:graphflow123@localhost:5432/graphflow
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# WebSocket Configuration
WS_ENABLED=true
WS_MAX_CONNECTIONS=100
WS_HEARTBEAT_INTERVAL=30

# Monitoring
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
DETAILED_LOGGING=true
LOG_FORMAT=json
LOG_FILE_PATH=/app/logs/graphflow.log

# Security
API_KEY_HEADER=X-API-Key
ENABLE_API_KEY_AUTH=true
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Feature Flags
ENABLE_ASYNC_PROCESSING=true
ENABLE_CACHING=true
CACHE_TTL_SECONDS=300
ENABLE_DECISION_LOGGING=true
ENABLE_PERFORMANCE_TRACKING=true

# Decision Matrix Configuration
CONFIDENCE_THRESHOLD_HIGH=0.8
CONFIDENCE_THRESHOLD_MEDIUM=0.5
PRIORITY_WEIGHT_URGENT=1.5
PRIORITY_WEIGHT_HIGH=1.2
PRIORITY_WEIGHT_MEDIUM=1.0
PRIORITY_WEIGHT_LOW=0.8

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=1.0
RETRY_BACKOFF_FACTOR=2.0

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# Development/Debug Settings
DEBUG_MODE=false
MOCK_INTEGRATIONS=false
TESTING_MODE=false