{
  "custom_business_rules": [
    {
      "id": "force_all_avatar_responses",
      "condition": "source == 'USER_INTERACTION' or priority == 'high' or 'speak' in content.lower() or 'hello' in content.lower()",
      "decision": "AVATAR_AND_ANALYSIS",
      "priority": 100,
      "description": "Force user interaction and test stimuli to trigger avatar responses",
      "enabled": true,
      "metadata": {
        "rule_type": "testing",
        "created": "2025-07-10"
      }
    },
    {
      "id": "e2e_test_full_processing",
      "condition": "metadata.get('test_type') is not None or source == 'e2e_test'",
      "decision": "AVATAR_AND_ANALYSIS",
      "priority": 99,
      "description": "All E2E test stimuli get full processing",
      "enabled": true,
      "metadata": {
        "rule_type": "testing",
        "created": "2025-07-09"
      }
    },
    {
      "id": "custom_vip_user",
      "condition": "metadata.get('user_type') == 'vip' and category == 'USER_INTERACTION'",
      "decision": "AVATAR_AND_ANALYSIS",
      "priority": 95,
      "description": "VIP users always get avatar responses",
      "enabled": true,
      "metadata": {
        "rule_type": "business",
        "created": "2025-01-01"
      }
    },
    {
      "id": "custom_scheduled_maintenance",
      "condition": "metadata.get('scheduled_maintenance', False) == True",
      "decision": "LOG_ONLY",
      "priority": 88,
      "description": "During scheduled maintenance, only log stimuli",
      "enabled": false,
      "metadata": {
        "rule_type": "operational"
      }
    }
  ],
  "custom_content_rules": [
    {
      "id": "custom_profanity_filter",
      "condition": "contains(metadata.get('content', ''), 'profanity_detected')",
      "decision": "LOG_ONLY",
      "priority": 92,
      "description": "Filter out content with detected profanity",
      "enabled": true,
      "metadata": {
        "rule_type": "content_moderation"
      }
    },
    {
      "id": "custom_language_support",
      "condition": "metadata.get('language') not in ['en', 'es', 'fr']",
      "decision": "ANALYSIS_ONLY",
      "priority": 55,
      "description": "Non-supported languages go to analysis only",
      "enabled": true,
      "metadata": {
        "rule_type": "language"
      }
    }
  ],
  "custom_time_based_rules": [
    {
      "id": "custom_night_mode",
      "condition": "environmental_analysis.get('time_of_day_factor', 1.0) < 0.3",
      "decision": "ANALYSIS_ONLY",
      "priority": 52,
      "description": "During night hours, prefer quiet analysis mode",
      "enabled": true,
      "metadata": {
        "rule_type": "temporal",
        "quiet_hours": "22:00-06:00"
      }
    },
    {
      "id": "custom_peak_hours",
      "condition": "environmental_analysis.get('time_of_day_factor', 1.0) > 0.8 and system_state.get('queue_size', 0) < 5",
      "decision": "AVATAR_AND_ANALYSIS",
      "priority": 67,
      "description": "During peak hours with low queue, maximize engagement",
      "enabled": true,
      "metadata": {
        "rule_type": "temporal",
        "peak_hours": "18:00-22:00"
      }
    }
  ]
}