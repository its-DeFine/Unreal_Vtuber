# AutoGen V3 Orchestrator Configuration Example
# This file shows the configuration needed to use the V3 (AutoGen-based) orchestrator

# ======================================
# 🤖 Orchestrator Configuration
# ======================================

# Orchestrator Version Selection
# Options: "v2" (deprecated), "v3" (AutoGen-based, recommended)
ORCHESTRATOR_VERSION=v3

# Enable autonomous orchestration
AUTONOMOUS_ORCHESTRATION_ENABLED=true
AUTO_INTERRUPT_ENABLED=true
AUTONOMOUS_ENVIRONMENT_ENABLED=true
AUTONOMOUS_SPEECH_ENABLED=true

# AutoGen V3 Specific Configuration
AUTOGEN_ORCHESTRATOR_ENABLED=true

# Persona Configuration
# Options: "interactive_streamer", "focused_artist", "casual_gamer"
ORCHESTRATOR_PERSONA=interactive_streamer

# Autonomous Content Generation
AUTONOMOUS_CONTENT_ENABLED=true

# Enable multi-agent group chat coordination
GROUP_CHAT_ENABLED=true

# SCB (System Context Buffer) Integration
SCB_INTEGRATION_ENABLED=true

# ======================================
# 🎯 Persona-Specific Settings
# ======================================

# For Interactive Streamer (default)
# - Quick responses to chat
# - High engagement
# - Frequent autonomous content
MIN_IDLE_TIME=8
MAX_IDLE_TIME=20
CONTENT_VARIETY=high

# For Focused Artist
# - Longer quiet periods
# - Less chat interruption
# - Thoughtful responses
# MIN_IDLE_TIME=15
# MAX_IDLE_TIME=45
# CONTENT_VARIETY=medium

# For Casual Gamer
# - Balanced interaction
# - Game-focused content
# - Moderate engagement
# MIN_IDLE_TIME=10
# MAX_IDLE_TIME=30
# CONTENT_VARIETY=high

# ======================================
# 🔧 Advanced AutoGen Settings
# ======================================

# Maximum inputs from SCB to include in prompts
SCB_MAX_INPUTS=3

# Agent decision timeout (milliseconds)
AGENT_DECISION_TIMEOUT=5000

# Maximum agent conversation rounds
MAX_AGENT_ROUNDS=10

# Agent temperature settings
ORCHESTRATOR_AGENT_TEMP=0.3
FILTER_AGENT_TEMP=0.1
SPEECH_AGENT_TEMP=0.7
IDLE_AGENT_TEMP=0.8

# ======================================
# 📊 Monitoring and Debugging
# ======================================

# Enable detailed agent conversation logging
AUTOGEN_DEBUG_MODE=false

# Prometheus metrics export
ENABLE_METRICS_EXPORT=true
METRICS_PORT=9090

# Agent performance tracking
TRACK_AGENT_PERFORMANCE=true

# ======================================
# 🚀 Migration from V2
# ======================================
# To migrate from V2 to V3:
# 1. Copy your existing .env file
# 2. Add ORCHESTRATOR_VERSION=v3
# 3. Add the AutoGen-specific settings above
# 4. Start your containers normally
# 5. Monitor logs for any issues
# 6. V2 endpoints remain compatible

# ======================================
# ⚠️ Deprecation Notice
# ======================================
# V2 orchestrator is deprecated and will be removed in future releases.
# Please migrate to V3 for improved features and performance.