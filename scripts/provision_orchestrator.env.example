# AWS configuration (subnet/AMI default to our shared values if omitted)
AWS_REGION=us-east-2
#AWS_SUBNET_ID=subnet-0aad8738d8ac9fc25
#AWS_AMI_ID=ami-0f09ef696435ff61a   # GPU-capable Ubuntu 22.04 AMI
AWS_INSTANCE_TYPE=g4dn.xlarge
AWS_SECURITY_GROUP_NAME=vtuber-orchestrator-autoprovision
ORCHESTRATOR_KEY_NAME=vtuber-orchestrator-key
AWS_INSTANCE_NAME=vtuber-unreal-orchestrator-test
#AWS_ROOT_VOLUME_GB=200

# Networking / allowlists
DEDICATED_CLIENT_IP=
ADMIN_SOURCE_IP=
PAYMENTS_BACKEND_IP=<payments-ipv4>
ALLOW_DEDICATED_IP_SSH=false
ALLOCATE_ELASTIC_IP=true
#ELASTIC_IP_ALLOCATION_ID=eipalloc-xxxxxxxxxxxxxxxxx

# Payments + orchestrator identity
PAYMENTS_API_URL=http://<payments-host>:8081
# Choose a unique orchestrator ID (admin will mint a token for this ID).
ORCHESTRATOR_ID=
# Payout wallet address (0x + 40 hex chars).
ORCHESTRATOR_ADDRESS=

# Optional overrides
# ORCHESTRATOR_CONTACT_EMAIL=ops@example.com
