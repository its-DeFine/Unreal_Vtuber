# ======================================
# 🚀 AUTONOMY VTUBER SYSTEM - ENVIRONMENT CONFIGURATION
# ======================================
# Created: 2025-07-14
# Architecture: S1 (NeuroSync) + S2 (AutoGen) + SCB + Orchestrator
# 
# This is a cleaned configuration file containing only actively used variables
# Removed ~60% of deprecated variables from old character management system
# ======================================

# ======================================
# 🔑 CORE API KEYS & SECRETS
# ======================================
# OpenAI Configuration
OPENAI_API_KEY=<your openai key here>
OPENAI_MODEL=gpt-4o

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs TTS
ELEVENLABS_API_KEY=<your elevenlabs key here>

# ======================================
# 🤖 LLM PROVIDER CONFIGURATION
# ======================================
# Choose your LLM provider: "openai", "ollama", "custom_local"
LLM_PROVIDER=ollama

# Ollama Configuration (Local LLM)
OLLAMA_API_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
USE_OLLAMA_TEXT_MODELS=true
OLLAMA_SMALL_MODEL=llama3.2:3b
OLLAMA_MEDIUM_MODEL=phi3:mini
OLLAMA_LARGE_MODEL=llama3.2:7b
USE_OLLAMA_EMBEDDING=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Custom Local LLM Configuration
LLM_API_URL=http://127.0.0.1:5050/generate_llama
LLM_STREAM_URL=http://127.0.0.1:5050/generate_stream

# Global LLM Settings
USE_STREAMING=true
USE_LOCAL_AI=false
USE_VECTOR_DB=false
MAX_CHUNK_LENGTH=500
FLUSH_TOKEN_COUNT=300

# ======================================
# 🗄️ DATABASE CONFIGURATION
# ======================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/autonomous_agent

# ======================================
# 🔄 REDIS & SCB CONFIGURATION
# ======================================
USE_REDIS_SCB=true
REDIS_SCB_URL=redis://redis_scb:6379/0

# SCB (Shared Contextual Bridge) Settings
SCB_API_DEBUG=true
SCB_POLL_INTERVAL_MS=15000

# ======================================
# 🎤 AUDIO & TTS CONFIGURATION
# ======================================
# TTS Provider Selection: "elevenlabs", "kokoro", "local"
TTS_PROVIDER=kokoro

# ElevenLabs TTS Configuration
DEFAULT_VOICE_NAME=Alice

# Kokoro TTS Configuration (Local TTS Server)
KOKORO_TTS_SERVER_URL=http://localhost:6006
KOKORO_DEFAULT_VOICE=af_sarah
KOKORO_TTS_TIMEOUT=30
KOKORO_TTS_LANGUAGE=en

# Local TTS Configuration
USE_LOCAL_AUDIO=false
LOCAL_TTS_URL=http://127.0.0.1:8000/generate_speech
USE_COMBINED_ENDPOINT=false

# ======================================
# 🎮 VTUBER SYSTEM CONFIGURATION
# ======================================
VTUBER_ENDPOINT_URL=http://neurosync:5001/process_text
VTUBER_PAYMENT_ENABLED=false
AUTONOMOUS_LOOP_INTERVAL=30000

# Unreal Engine TCP Connection (for visual identity)
# Use "host.docker.internal" when running in Docker
# Use "127.0.0.1" when running locally
UNREAL_TCP_HOST=host.docker.internal
UNREAL_TCP_PORT=7777

# ======================================
# 🧠 MEMORY CONFIGURATION
# ======================================
MEMORY_ARCHIVING_ENABLED=true
MEMORY_ACTIVE_LIMIT=200
MEMORY_ARCHIVE_HOURS=48
MEMORY_IMPORTANCE_THRESHOLD=0.3

# ======================================
# 🌐 NETWORK & PORTS
# ======================================
PORT=3000
PLAYER_PORT=5001
UI_PORT=3000

# ======================================
# 📊 LOGGING & MONITORING
# ======================================
LOG_LEVEL=INFO
DB_LOGGING=false
NODE_ENV=development
DEBUG=false

# ======================================
# 🔧 OPTIONAL INTEGRATIONS
# ======================================
# Discord Integration (Optional)
# DISCORD_APPLICATION_ID=your_discord_app_id_here
# DISCORD_API_TOKEN=your_discord_api_token_here
# SCB_DISCORD_CHANNEL_ID=your_discord_channel_id_here

# PostgreSQL Alternative Configuration (Optional)
# POSTGRES_URL=postgresql://user:password@host:port/database

# ======================================
# 💡 QUICK SETUP GUIDE
# ======================================
# 
# For Local LLM (Ollama - Recommended):
# 1. Set LLM_PROVIDER=ollama
# 2. Run: cd docker-vtuber/app/AVATAR/NeuroBridge/NeuroSync_Player && ./setup_ollama.sh
# 3. Start your VTuber system: docker-compose -f docker-compose.all.yml up -d
#
# For OpenAI (Cloud):
# 1. Set LLM_PROVIDER=openai
# 2. Add your OPENAI_API_KEY
# 3. Choose your OPENAI_MODEL
#
# For Custom Local API:
# 1. Set LLM_PROVIDER=custom_local
# 2. Configure LLM_API_URL and LLM_STREAM_URL
# 3. Ensure your local API is running
#
# For TTS Configuration:
# - ElevenLabs (Cloud): Set TTS_PROVIDER=elevenlabs + ELEVENLABS_API_KEY
# - Kokoro (Local): Set TTS_PROVIDER=kokoro + KOKORO_TTS_SERVER_URL
# - Local TTS: Set TTS_PROVIDER=local + LOCAL_TTS_URL
#
# ======================================
# 🗑️ CLEANUP SUMMARY
# ======================================
# Removed deprecated variables:
# - Old character management system (CONDUCTOR, SYNTHESISER, etc.)
# - Unused services (COGNEE, STUDIOLM, CLOUDFLARE)
# - Crypto/blockchain variables (BIRDEYE, SOLANA, EVM, etc.)
# - Social media integrations (TWITTER, TELEGRAM)
# - Security variables (JWT_SECRET, ENCRYPTION_KEY)
# - Duplicate API keys and database URLs
# 
# Total reduction: ~60% of variables removed
# Architecture focus: S1 + S2 + SCB + Orchestrator only
# ======================================